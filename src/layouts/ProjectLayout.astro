---
import type { CollectionEntry } from "astro:content"
import { Icon } from "astro-icon/components"

import Carousel from "@/components/Carousel.astro"
import Footer from "@/components/Footer.astro"
import Header from "@/components/Header.astro"
import TechStack from "@/components/TechStack.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"

interface Props {
  project: CollectionEntry<"projects">
}
const {
  project: {
    id,
    data: {
      title,
      description,
      type,
      period,
      techStack,
      links,
      accounts,
      images,
      features,
      decisions,
      troubleshooting,
    },
  },
} = Astro.props
---

<BaseLayout
  title={`${title} | 송현정 포트폴리오`}
  description={description}
  image={`/images/${id}.png`}
>
  <Header />

  <main>
    <div class="page-wrap pt-4 md:pt-8">
      <a
        href="/#projects"
        class="group inline-flex items-center justify-center gap-2 side-heading hover:text-foreground focus-visible:text-foreground motion-safe:transition-[color]"
      >
        <Icon
          name="radix-icons:chevron-left"
          aria-hidden="true"
          class="shrink-0 translate-x-0.5 group-hover:-translate-x-0.5 group-focus-visible:-translate-x-0.5 motion-safe:transition-[translate]"
        />
        <span class="text-nowrap">프로젝트 목록으로</span>
      </a>
    </div>

    <article aria-labelledby="project-title">
      <header class="page-wrap mt-6 md:mt-8">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 side-heading">
          <span>{type}</span>
          <span class="tabular-nums">{`${period.start} - ${period.end ?? "진행 중"}`}</span>
        </p>
        <h1 id="project-title" class="mt-2 text-title">
          {title}
        </h1>
      </header>

      <section aria-label="스크린샷 캐러셀" class="page-wrap mt-8 md:mt-12">
        <Carousel images={images} alt={`${title} 스크린샷`} />
      </section>

      <section
        aria-labelledby="overview-heading"
        class="page-wrap mt-16 grid gap-12 md:mt-24 md:grid-cols-12 md:gap-8"
      >
        <div class="md:col-span-7">
          <h2 id="overview-heading" class="section-heading">
            프로젝트 소개
          </h2>
          <div class="flex flex-col gap-4">
            <slot name="overview" />
          </div>
        </div>

        <div class="flex flex-col gap-8 md:col-span-4 md:col-start-9">
          <div>
            <h3 class="mb-2 side-heading">기술 스택</h3>
            <TechStack items={techStack} />
          </div>

          <div>
            <h3 class="mb-2 side-heading">링크</h3>
            <div class="flex flex-wrap items-center gap-2">
              <a
                href={links.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${title} 깃허브 (새 탭에서 열림)`}
                class="pill-button h-9 px-4 text-label"
              >
                <Icon name="radix-icons:github-logo" aria-hidden="true" class="shrink-0" />
                <span class="text-nowrap">깃허브</span>
              </a>

              {links.demo && (
                <a
                  href={links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${title} 데모 (새 탭에서 열림)`}
                  class="pill-button h-9 px-4 text-label"
                >
                  <Icon name="radix-icons:globe-2" aria-hidden="true" class="shrink-0" />
                  <span class="text-nowrap">데모</span>
                </a>
              )}
            </div>
          </div>

          {accounts.length > 0 && (
            <div>
              <h3 class="mb-2 side-heading">테스트 계정</h3>
              <table class="w-full border-collapse text-label">
                <caption class="sr-only">테스트 계정 정보</caption>
                <thead class="sr-only">
                  <tr>
                    <th scope="col">구분</th>
                    <th scope="col">아이디와 비밀번호</th>
                  </tr>
                </thead>
                <tbody>
                  {accounts.map((account) => (
                    <tr class="border-t last:border-b">
                      <th scope="row" class="py-2 pr-4 text-left align-top font-medium text-nowrap">
                        {account.label}
                      </th>
                      <td class="space-y-2 py-2">
                        {[
                          { value: account.username, name: "아이디" },
                          { value: account.password, name: "비밀번호" },
                        ].map(({ value, name }) => (
                          <button
                            type="button"
                            data-copy={value}
                            aria-label={`${account.label} ${name} 복사`}
                            class="inline-flex w-full items-center justify-between gap-2 text-left font-mono font-normal text-muted-foreground hover:text-foreground focus-visible:text-foreground motion-safe:transition-[color]"
                          >
                            <span class="break-all">{value}</span>
                            <Icon name="radix-icons:copy" aria-hidden="true" class="shrink-0" />
                          </button>
                        ))}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>

      {features.length > 0 && (
        <section aria-labelledby="features-heading" class="page-wrap mt-16 md:mt-24">
          <h2 id="features-heading" class="section-heading">
            주요 기능
          </h2>
          <div class="grid gap-y-3 md:grid-cols-[auto_1fr] md:items-baseline md:gap-x-12 md:gap-y-8">
            <slot name="features" />
          </div>
        </section>
      )}

      <slot name="supplementary" />

      {decisions.length > 0 && (
        <section aria-labelledby="decisions-heading" class="page-wrap mt-16 md:mt-24">
          <h2 id="decisions-heading" class="section-heading">
            기술적 고민과 선택
          </h2>
          <ul class="grid gap-4 md:grid-cols-2">
            <slot name="decisions" />
          </ul>
        </section>
      )}

      {troubleshooting.length > 0 && (
        <section aria-labelledby="troubleshooting-heading" class="page-wrap mt-16 md:mt-24">
          <h2 id="troubleshooting-heading" class="section-heading">
            문제 해결 과정
          </h2>
          <div class="flex flex-col gap-16">
            <slot name="troubleshooting" />
          </div>
        </section>
      )}
    </article>
  </main>

  <Footer />

  <div
    id="toast"
    role="status"
    aria-live="polite"
    class="pointer-events-none invisible fixed top-4 left-1/2 z-50 inline-flex -translate-x-1/2 -translate-y-4 items-center justify-center gap-2 rounded-full glass px-6 py-3 text-label opacity-0 data-visible:visible data-visible:translate-y-0 data-visible:opacity-100 motion-safe:transition-[opacity,translate,visibility]"
  >
    <Icon
      name="radix-icons:check-circled"
      data-toast-icon="success"
      aria-hidden="true"
      class="hidden shrink-0"
    />
    <Icon
      name="radix-icons:cross-circled"
      data-toast-icon="error"
      aria-hidden="true"
      class="hidden shrink-0"
    />
    <span data-toast-message class="text-nowrap"></span>
  </div>
</BaseLayout>

<script>
  const toast = document.querySelector<HTMLElement>("#toast")
  const toastMessage = toast?.querySelector<HTMLElement>("[data-toast-message]")
  const toastIcons = toast?.querySelectorAll<SVGElement>("[data-toast-icon]") ?? []
  let toastTimeout: ReturnType<typeof setTimeout>

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      if (!toast || !toastMessage) return

      let state: "success" | "error" = "success"
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
      } catch {
        state = "error"
      }

      toastIcons.forEach((icon) =>
        icon.classList.toggle("hidden", icon.dataset.toastIcon !== state)
      )
      toastMessage.textContent =
        state === "success" ? "클립보드에 복사했습니다" : "복사하지 못했습니다"

      toast.toggleAttribute("data-visible", true)
      clearTimeout(toastTimeout)
      toastTimeout = setTimeout(() => toast.toggleAttribute("data-visible", false), 2500)
    })
  })
</script>
