---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import { Icon } from "astro-icon/components"

import TechStack from "@/components/TechStack.astro"

interface Props {
  project: CollectionEntry<"projects">
  reverse?: boolean
}
const {
  project: { id, data },
  reverse = false,
} = Astro.props
---

<div class="group relative grid gap-5 md:grid-cols-12 md:gap-12">
  <div
    class:list={[
      "aspect-5/3 min-w-0 overflow-hidden rounded-2xl border bg-surface md:col-span-7",
      reverse && "md:order-last",
    ]}
  >
    <Image
      src={data.thumbnail}
      alt={`${data.title} 썸네일`}
      class="block size-full object-cover group-hover:scale-[1.02] motion-safe:transition-[scale] motion-safe:duration-500"
    />
  </div>

  <div class="flex flex-col md:col-span-5">
    <p class="side-heading">{data.type}</p>

    <h3 class="mt-1 flex items-center justify-between text-card-title text-nowrap">
      <a
        href={`/projects/${id}`}
        class="group-hover:text-accent after:absolute after:inset-0 after:z-1 focus-visible:text-accent motion-safe:transition-[color]"
      >
        {data.title}
      </a>
      <Icon
        name="radix-icons:arrow-right"
        aria-hidden="true"
        class="shrink-0 -translate-x-0.5 group-hover:translate-x-0.5 motion-safe:transition-[translate]"
      />
    </h3>

    <p class="mt-3 text-muted-foreground">{data.description}</p>

    <TechStack items={data.techStack} class="mt-4" />
  </div>
</div>
