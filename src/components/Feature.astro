---
import type { CollectionEntry } from "astro:content"

interface Props {
  feature: CollectionEntry<"projects">["data"]["features"][number]
}
const { feature } = Astro.props
---

<h3 class="mt-5 text-subheading text-nowrap first:mt-0 md:mt-0">{feature.title}</h3>
<ul class="ml-4.5 list-disc marker:text-border-strong">
  {feature.details.map(({ content, tag }) => (
    <li>
      <Fragment set:html={content} />
      {tag && (
        <span class="ml-1.5 rounded-md border px-1.5 py-0.5 text-caption text-nowrap text-muted-foreground">
          {tag}
        </span>
      )}
    </li>
  ))}
</ul>
