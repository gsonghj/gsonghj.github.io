---
import type { CollectionEntry } from "astro:content"

interface Props {
  feature: CollectionEntry<"projects">["data"]["features"][number]
}
const { feature } = Astro.props
---

<h3 class="font-semibold text-nowrap">{feature.title}</h3>
<ul class="ml-4.5 list-disc marker:text-border">
  {feature.details.map(({ content, tag }) => (
    <li>
      <Fragment set:html={content} />
      {tag && (
        <span class="ml-1 rounded-sm bg-accent-soft px-1 py-0.5 text-sm font-medium text-accent">
          {tag}
        </span>
      )}
    </li>
  ))}
</ul>
