---
import { Icon } from "astro-icon/components"
---

<button
  id="scroll-to-top"
  type="button"
  aria-label="맨 위로 이동"
  class="invisible fixed right-4 bottom-4 z-50 glass-button translate-y-2 opacity-0 data-visible:visible data-visible:translate-y-0 data-visible:opacity-100 motion-safe:transition-[opacity,translate,visibility,right,bottom] md:right-8 md:bottom-8"
>
  <Icon name="radix-icons:arrow-up" aria-hidden="true" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("#scroll-to-top")
  const header = document.querySelector<HTMLElement>("#header")

  if (button && header) {
    const observer = new IntersectionObserver(([entry]) =>
      button.toggleAttribute("data-visible", !entry.isIntersecting)
    )
    observer.observe(header)
    button.addEventListener("click", () => window.scrollTo({ top: 0 }))
  }
</script>
