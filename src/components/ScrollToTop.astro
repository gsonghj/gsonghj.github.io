---
import { Icon } from "astro-icon/components"
---

<div
  id="scroll-sentinel"
  aria-hidden="true"
  class="pointer-events-none absolute inset-x-0 top-0 h-[50svh]"
></div>

<button
  id="scroll-to-top"
  type="button"
  aria-label="맨 위로 이동"
  class="invisible fixed right-4 bottom-4 z-40 glass-button translate-y-2 opacity-0 data-visible:visible data-visible:translate-y-0 data-visible:opacity-100 motion-safe:transition-[opacity,translate,visibility,right,bottom] md:right-8 md:bottom-8"
>
  <Icon name="radix-icons:arrow-up" aria-hidden="true" class="shrink-0" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("#scroll-to-top")
  const sentinel = document.querySelector<HTMLElement>("#scroll-sentinel")

  if (button && sentinel) {
    const observer = new IntersectionObserver(([entry]) =>
      button.toggleAttribute("data-visible", !entry.isIntersecting)
    )
    observer.observe(sentinel)
    button.addEventListener("click", () => window.scrollTo({ top: 0 }))
  }
</script>
