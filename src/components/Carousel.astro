---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"

interface Props {
  images: ImageMetadata[]
  alt: string
}
const { images, alt } = Astro.props
---

<div class="embla relative">
  <div class="embla__viewport overflow-hidden">
    <div class="embla__container flex touch-pan-y touch-pinch-zoom">
      {images.map((image, index) => (
        <div class="embla__slide aspect-5/3 min-w-0 flex-[0_0_100%]">
          <Image
            src={image}
            alt={`${alt} ${index + 1}`}
            priority={index === 0}
            class="embla__image block size-full bg-surface object-cover"
          />
        </div>
      ))}
    </div>
  </div>

  <button
    type="button"
    aria-label="이전 스크린샷"
    class="embla__prev absolute top-1/2 left-0 z-1 glass-button -translate-x-1/3 -translate-y-1/2 motion-safe:transition-[translate] md:-translate-x-1/2"
  >
    <Icon name="radix-icons:chevron-left" aria-hidden="true" />
  </button>
  <button
    type="button"
    aria-label="다음 스크린샷"
    class="embla__next absolute top-1/2 right-0 z-1 glass-button translate-x-1/3 -translate-y-1/2 motion-safe:transition-[translate] md:translate-x-1/2"
  >
    <Icon name="radix-icons:chevron-right" aria-hidden="true" />
  </button>
</div>

<script>
  import EmblaCarousel from "embla-carousel"
  import Autoplay from "embla-carousel-autoplay"

  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches

  document.querySelectorAll<HTMLElement>(".embla").forEach((embla) => {
    const viewport = embla.querySelector<HTMLElement>(".embla__viewport")
    const prevButton = embla.querySelector<HTMLButtonElement>(".embla__prev")
    const nextButton = embla.querySelector<HTMLButtonElement>(".embla__next")

    if (!viewport || !prevButton || !nextButton) return

    const options = reducedMotion ? { duration: 0, loop: true } : { duration: 40, loop: true }
    const plugins = reducedMotion
      ? []
      : [Autoplay({ delay: 5000, stopOnInteraction: true, stopOnMouseEnter: true })]

    const emblaApi = EmblaCarousel(viewport, options, plugins)

    prevButton.addEventListener("click", () => emblaApi.scrollPrev())
    nextButton.addEventListener("click", () => emblaApi.scrollNext())
  })
</script>
