---
import type { CollectionEntry } from "astro:content"

interface Props {
  troubleshooting: CollectionEntry<"projects">["data"]["troubleshooting"][number]
}
const { troubleshooting } = Astro.props

const steps = [
  { key: "problem", label: "문제" },
  { key: "analysis", label: "분석" },
  { key: "action", label: "행동" },
  { key: "result", label: "결과" },
] as const
---

{/* 모바일: 모두 세로로 쌓음 / md: 제목 위, 레이블과 본문 좌우 / lg: 제목 왼쪽 sticky */}
<div class="grid gap-3 md:gap-6 lg:grid-cols-12 lg:gap-8">
  <h3 class="text-subheading lg:sticky lg:top-[calc(var(--spacing-header)+(--spacing(12)))] lg:col-span-4 lg:self-start">
    {troubleshooting.title}
  </h3>
  <dl class="grid gap-y-5 md:grid-cols-[auto_1fr] md:gap-x-10 lg:col-span-8">
    {steps.map((step) => (
      <div
        class:list={[
          "grid gap-2 md:col-span-2 md:grid-cols-subgrid md:items-baseline md:gap-x-10",
          step.key === "result" &&
            "-mx-4 rounded-2xl bg-accent-muted p-4 dark:ring-1 dark:ring-accent/35",
        ]}
      >
        <dt
          class:list={[
            "text-label",
            step.key === "result" ? "text-accent" : "text-muted-foreground",
          ]}
        >
          {step.label}
        </dt>
        <dd set:html={troubleshooting[step.key]} />
      </div>
    ))}
  </dl>
</div>
